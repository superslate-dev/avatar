{
  "name": "@superslate/avatar",
  "version": "0.1.1",
  "description": "Soft gradient SVG avatar generator with 6 shape families, 40 palettes, light/dark appearances, and OKLCH tone controls. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Supercollective <npm@supercollective.studio> (https://superslate.dev)",
  "homepage": "https://superslate.dev/avatars/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superslate-dev/avatar.git"
  },
  "bugs": {
    "url": "https://github.com/superslate-dev/avatar/issues"
  },
  "keywords": [
    "avatar",
    "avatar-generator",
    "svg",
    "gradient",
    "oklch",
    "identicon",
    "profile-picture",
    "react",
    "dark-mode",
    "superslate"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "superslate-avatar": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "build:studio": "vite build",
    "dev": "vite --host",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel --randomize",
    "smoke": "node -e \"const m=require('./dist/index.cjs');if(typeof m.createAvatar!=='function')throw new Error('cjs entry broken')\" && node --input-type=module -e \"import('./dist/index.js').then(m=>{if(typeof m.createAvatar!=='function')throw new Error('esm entry broken')})\" && node dist/cli.js help > /dev/null",
    "preview:assets": "node scripts/generate-preview.mjs",
    "preview:og": "node scripts/generate-og.mjs",
    "cf:deploy": "wrangler deploy",
    "verify": "bun run typecheck && bun run test && bun run build && bun run smoke && bun run build:studio",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun run smoke"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
