exports[`golden output locks ember / electric-iris / dark 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64" role="img">
    <title>Ember avatar</title>
    <defs>
    <filter id="blur-1-av-8kwije" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="1.1"/></filter>
    <filter id="blur-3-av-8kwije" x="-55%" y="-55%" width="210%" height="210%"><feGaussianBlur stdDeviation="3.2"/></filter>
