    <g transform="translate(32.030 32.030) rotate(0.000)"><rect x="-32.030" y="-32.030" width="64.060" height="64.060" rx="16.270" fill="#b99bff" opacity="1.000" filter="url(#dark-surface-av-8kwije)"/></g>
    
